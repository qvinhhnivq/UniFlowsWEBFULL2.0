{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "unihub\\..*"
        }
      ],
      "destination": "/unihube.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "publishing\\..*"
        }
      ],
      "destination": "/unipublishing.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "48k\\..*"
        }
      ],
      "destination": "/48k.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "portal\\..*"
        }
      ],
      "destination": "/artist-login.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "artist\\..*"
        }
      ],
      "destination": "/artist-login.html"
    }
  ]
}
