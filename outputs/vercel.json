{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/unihube",
      "has": [
        {
          "type": "host",
          "value": "unihub.(.*)"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/unipublishing",
      "has": [
        {
          "type": "host",
          "value": "publishing.(.*)"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/48k",
      "has": [
        {
          "type": "host",
          "value": "48k.(.*)"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/artist-login",
      "has": [
        {
          "type": "host",
          "value": "portal.(.*)"
        }
      ],
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "unihub.(.*)"
        }
      ],
      "destination": "/unihube.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "publishing.(.*)"
        }
      ],
      "destination": "/unipublishing.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "48k.(.*)"
        }
      ],
      "destination": "/48k.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "portal.(.*)"
        }
      ],
      "destination": "/artist-login.html"
    }
  ]
}
