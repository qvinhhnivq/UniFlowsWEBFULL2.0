{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/listen/:path*", "destination": "/listen.html" },
    { "source": "/l/:path*", "destination": "/listen.html" },
    { "source": "/article/:path*", "destination": "/article.html" },
    { "source": "/artist/:path*", "destination": "/artist.html" }
  ]
}
