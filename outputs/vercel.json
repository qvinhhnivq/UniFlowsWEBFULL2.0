{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "unihub.(.*)"
        }
      ],
      "destination": "/unihube",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "publishing.(.*)"
        }
      ],
      "destination": "/unipublishing",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "48k.(.*)"
        }
      ],
      "destination": "/48k",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "portal.(.*)"
        }
      ],
      "destination": "/artist-portal",
      "permanent": false
    }
  ]
}
