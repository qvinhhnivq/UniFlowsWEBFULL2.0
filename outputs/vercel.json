{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/48k",
      "destination": "/48kcollective",
      "permanent": false
    },
    {
      "source": "/unihub",
      "destination": "/unihube",
      "permanent": false
    },
    {
      "source": "/uni-hube",
      "destination": "/unihube",
      "permanent": false
    },
    {
      "source": "/publishing",
      "destination": "/unipublishing",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "48k.uniflowslabel.com"
        }
      ],
      "destination": "/48kcollective.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "48kcollective.uniflowslabel.com"
        }
      ],
      "destination": "/48kcollective.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "uni-hube.uniflowslabel.com"
        }
      ],
      "destination": "/unihube.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "unihube.uniflowslabel.com"
        }
      ],
      "destination": "/unihube.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "hube.uniflowslabel.com"
        }
      ],
      "destination": "/unihube.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "unihub.uniflowslabel.com"
        }
      ],
      "destination": "/unihube.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "publishing.uniflowslabel.com"
        }
      ],
      "destination": "/unipublishing.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "unipublishing.uniflowslabel.com"
        }
      ],
      "destination": "/unipublishing.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "portal.uniflowslabel.com"
        }
      ],
      "destination": "/artist-login.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "artist.uniflowslabel.com"
        }
      ],
      "destination": "/artist-login.html"
    },
    {
      "source": "/s/(.*)",
      "destination": "/s.html?s=$1"
    },
    {
      "source": "/s/:slug*",
      "destination": "/s.html?s=:slug*"
    },
    {
      "source": "/s",
      "destination": "/s.html"
    },
    {
      "source": "/shortener",
      "destination": "/s.html"
    },
    {
      "source": "/go/(.*)",
      "destination": "/s.html?s=$1"
    },
    {
      "source": "/go/:slug*",
      "destination": "/s.html?s=:slug*"
    },
    {
      "source": "/r/(.*)",
      "destination": "/s.html?s=$1"
    },
    {
      "source": "/r/:slug*",
      "destination": "/s.html?s=:slug*"
    },
    {
      "source": "/listen/(.*)",
      "destination": "/listen.html?release=$1"
    },
    {
      "source": "/listen/:slug*",
      "destination": "/listen.html?release=:slug*"
    },
    {
      "source": "/listen",
      "destination": "/listen.html"
    },
    {
      "source": "/l/(.*)",
      "destination": "/listen.html?release=$1"
    },
    {
      "source": "/l/:slug*",
      "destination": "/listen.html?release=:slug*"
    },
    {
      "source": "/l",
      "destination": "/listen.html"
    },
    {
      "source": "/smartlink/(.*)",
      "destination": "/listen.html?release=$1"
    },
    {
      "source": "/smartlink/:slug*",
      "destination": "/listen.html?release=:slug*"
    },
    {
      "source": "/smartlink",
      "destination": "/listen.html"
    }
  ]
}
