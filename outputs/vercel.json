{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/48k",
      "destination": "/48kcollective",
      "permanent": false
    },
    {
      "source": "/unihub",
      "destination": "/unihube",
      "permanent": false
    },
    {
      "source": "/publishing",
      "destination": "/unipublishing",
      "permanent": false
    },
    {
      "source": "/portal",
      "destination": "/artist-login",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/listen/:slug*",
      "destination": "/listen.html"
    },
    {
      "source": "/listen",
      "destination": "/listen.html"
    },
    {
      "source": "/l/:slug*",
      "destination": "/listen.html"
    },
    {
      "source": "/l",
      "destination": "/listen.html"
    },
    {
      "source": "/smartlink/:slug*",
      "destination": "/listen.html"
    },
    {
      "source": "/smartlink",
      "destination": "/listen.html"
    },
    {
      "source": "/producer",
      "has": [
        {
          "type": "host",
          "value": "unihub.uniflowslabel.com"
        }
      ],
      "destination": "/producer.html"
    },
    {
      "source": "/producer/:path*",
      "has": [
        {
          "type": "host",
          "value": "unihub.uniflowslabel.com"
        }
      ],
      "destination": "/producer.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "unihub.uniflowslabel.com"
        }
      ],
      "destination": "/unihube.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "hube.uniflowslabel.com"
        }
      ],
      "destination": "/unihube.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "publishing.uniflowslabel.com"
        }
      ],
      "destination": "/unipublishing.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "48k.uniflowslabel.com"
        }
      ],
      "destination": "/48kcollective.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "portal.uniflowslabel.com"
        }
      ],
      "destination": "/artist-login.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "artist.uniflowslabel.com"
        }
      ],
      "destination": "/artist-login.html"
    },
    {
      "source": "/portal",
      "has": [
        {
          "type": "host",
          "value": "portal.uniflowslabel.com"
        }
      ],
      "destination": "/portal.html"
    },
    {
      "source": "/portal/:path*",
      "has": [
        {
          "type": "host",
          "value": "portal.uniflowslabel.com"
        }
      ],
      "destination": "/portal.html"
    }
  ]
}
