{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/listen/(.*)",
      "destination": "/listen.html"
    },
    {
      "source": "/listen",
      "destination": "/listen.html"
    },
    {
      "source": "/l/(.*)",
      "destination": "/listen.html"
    },
    {
      "source": "/l",
      "destination": "/listen.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "unihub.uniflowslabel.com"
        }
      ],
      "destination": "/unihube.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "publishing.uniflowslabel.com"
        }
      ],
      "destination": "/unipublishing.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "48k.uniflowslabel.com"
        }
      ],
      "destination": "/48kcollective.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "portal.uniflowslabel.com"
        }
      ],
      "destination": "/artist-login.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "unihub.(.*)"
        }
      ],
      "destination": "/unihube.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "publishing.(.*)"
        }
      ],
      "destination": "/unipublishing.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "48k.(.*)"
        }
      ],
      "destination": "/48kcollective.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "portal.(.*)"
        }
      ],
      "destination": "/artist-login.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "artist.(.*)"
        }
      ],
      "destination": "/artist-login.html"
    }
  ]
}
