{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/48k",
      "destination": "/48kcollective",
      "permanent": true
    },
    {
      "source": "/unihub",
      "destination": "/unihube",
      "permanent": true
    },
    {
      "source": "/publishing",
      "destination": "/unipublishing",
      "permanent": true
    },
    {
      "source": "/portal",
      "destination": "/artist-login",
      "permanent": true
    },
    {
      "source": "/submit-demo",
      "destination": "/submit-music",
      "permanent": true
    },
    {
      "source": "/artist-portal",
      "destination": "/artist-login",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "unihub.(.*)"
        }
      ],
      "destination": "/unihube.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "publishing.(.*)"
        }
      ],
      "destination": "/unipublishing.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "48k.(.*)"
        }
      ],
      "destination": "/48kcollective.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "portal.(.*)"
        }
      ],
      "destination": "/artist-login.html"
    }
  ]
}
